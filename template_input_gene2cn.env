#!/usr/bin/env bash
# gene2CN pipeline configuration (source this file)
# Usage:
#   sbatch gene2CN_parent.slurm /path/to/input.env

# REQUIRED: set META_IN to the full filepath of your metadata file (tsv/csv/xlsx/xls/txt with Sample/Pop/FTP paths columns)
META_IN=""

# ---- Globus / Transfer settings ----
# Endpoint/Collection IDs - probably will not have to change
ENA="47772002-3e5b-4fd3-b97c-18cee38d6df2"
UB_SCRATCH="8619b16d-5fb1-4333-8858-16f49aa33d76"

# Max concurrent ACTIVE Globus tasks for this identity
CAP_XFER=4 # do not change

# Polling interval used by each transfer job's `globus task wait`
# Fixed value chosen to stay under Globus Transfer service request rate limits when ~101 processes poll.
# (see parent script for derivation)
GLOBUS_POLL_SECS=10 # do not change
# Jitter range (0..N-1 seconds) added before waiting to desynchronize polling
GLOBUS_POLL_JITTER_SECS=5 # do not change

# Parent loop sleep between globus task list checks
PARENT_POLL_SECS=10 # do not change

# ---- Cluster / filesystem paths ----
# Where on vscratch to put fastqs
path_genomes="grp-omergokc/"
vscratch_dir="/vscratch/${path_genomes}"

# ---- Conda environments ----
CONDA_HOOK=""
PARENT_CONDA_ENV="" # must include globus
COMPUTE_CONDA_ENV=""

# ---- GeneToCN compute inputs ----
database_location=""
gm=""
regions_txt=""
KMER_SCRIPT=""
db_file=""
